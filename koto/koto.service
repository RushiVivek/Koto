[Unit]
Description=koto todo server
After=network.target

[Service]
Type=simple
User=koto
Group=koto

# Token and other secrets live in a chmod-600 file:
#   /etc/koto/env
# with content like:
#   KOTO_TOKEN=replace-me
EnvironmentFile=/etc/koto/env

# /var/lib/koto is created and owned by the service user automatically.
StateDirectory=koto
StateDirectoryMode=0700
Environment=KOTO_DB_PATH=/var/lib/koto/koto.db

ExecStart=/usr/bin/koto serve --host 0.0.0.0 --port 28080
Restart=on-failure
RestartSec=5

# --- Sandboxing ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
