/* koto TUI styles */

Screen {
    background: $surface;
}

/* `Screen` above also matches modal screens, which made every dialog's
   backdrop opaque (hiding the app) in all but the ANSI themes. Restore a
   translucent backdrop so the app stays visible, dimmed, behind dialogs. */
ModalScreen {
    background: $background 60%;
    &:ansi {
        background: transparent;
    }
}

#main {
    layout: horizontal;
    height: 1fr;
}

WorkspaceTree {
    width: 32;
    border-right: tall $primary 30%;
    padding: 0 1;
}

TodoTree {
    width: 1fr;
    padding: 0 1;
    /* Rows are truncated/padded to the panel width; never scroll sideways. */
    overflow-x: hidden;
}

WorkspaceTree:focus,
TodoTree:focus {
    border-right: tall $primary;
}

/* Use Textual's built-in cursor styling so it follows the active theme.
   `render_label` passes the style through, so the cursor is visible. */

#toast {
    dock: bottom;
    height: auto;
    padding: 0 1;
    background: $error 30%;
    color: $text;
    text-style: bold;
    display: none;
}

#toast.visible {
    display: block;
}

#toast.info {
    background: $primary 30%;
}

/* ---------- Dialogs: one shared look for every modal ---------- */

ModalScreen {
    align: center middle;
}

ModalScreen > #dialog {
    width: 64;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    padding: 1 2;
    border: round $primary;
    border-title-color: $primary;
    border-title-style: bold;
    background: $surface;
}

ModalScreen #buttons {
    layout: horizontal;
    height: auto;
    align: right middle;
    margin-top: 1;
}

ModalScreen #buttons Button {
    margin-left: 1;
    min-width: 12;
}

ModalScreen #hint {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: $text-muted;
}

/* Destructive dialogs swap the accent for the error colour. */
ConfirmModal > #dialog {
    border: round $error;
    border-title-color: $error;
}

ConfirmModal #detail {
    color: $text-muted;
    margin-top: 1;
}

TodoEditModal Label {
    color: $text-muted;
    margin-top: 1;
}

TodoEditModal Label.first {
    margin-top: 0;
}

TodoEditModal #error {
    color: $error;
    margin-top: 1;
    display: none;
}

TodoEditModal #error.visible {
    display: block;
}

HelpScreen > #dialog {
    width: 76;
}
